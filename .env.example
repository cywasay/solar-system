# Copy to .env.local for development; set the same names in the Vercel project for production.
# Never commit real values — .env.local is gitignored, this file is not.

# --- Database (required) ---------------------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=

# --- Admin console (/admin) ------------------------------------------------------------
# 12+ characters. There is NO default: without a valid value admin sign-in is refused.
# Generate one:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=
# Long random string mixed into session-cookie signing. Changing it signs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Email via Resend (optional) -------------------------------------------------------
# Without RESEND_API_KEY no email is sent; the admin console then offers
# "Mark replied without emailing" instead of silently recording replies that never went out.
RESEND_API_KEY=
# Where new-message notifications are delivered to (you).
CONTACT_NOTIFY_EMAIL=
# Sender address. The default (onboarding@resend.dev) is Resend's shared TEST sender: it can
# only deliver to the Resend account owner, so replies to customers will be rejected.
# Verify a domain in Resend, then set e.g. support@yourdomain.com.
RESEND_FROM_EMAIL=

# --- Hosting (optional) ----------------------------------------------------------------
# Rate limits key on the client IP. x-forwarded-for is only trusted on Vercel (automatic).
# Behind your own reverse proxy that overwrites it, set this to 1. Anywhere else, leave it
# unset: all visitors then share one rate-limit bucket instead of being spoofable.
TRUST_PROXY=
