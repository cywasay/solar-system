generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD")
  replyText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
